<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    ══════════════════════════════════════════════════════════════════════
     artifactId / final-name 은 투라코(Turaco) 서비스명과 같아야 한다
    ══════════════════════════════════════════════════════════════════════
     Jenkinsfile 의 podman build 단계가 JAR_FILE 빌드인자를 "$SERVICE_NAME.jar" 로
     넘기기 때문에, target/borami-xvarm-broker-1joiuorqhl.jar 가 나와야
     개발계 이미지 빌드가 성공한다.

     운영(보라미 서버)에 수동 배포할 때 접미사 없는 이름이 낫다면 빌드 시 덮어쓴다.
       mvn clean package -Dfinal-name=borami-xvarm-broker
  -->
  <groupId>com.correction.borami</groupId>
  <artifactId>borami-xvarm-broker-1joiuorqhl</artifactId>
  <version>0.0.1</version>
  <packaging>jar</packaging>

  <name>borami-xvarm-broker</name>
  <description>보라미 WAS 내부에서 XVARM 을 대신 호출해 주는 최소 REST 브로커</description>

  <!--
    ══════════════════════════════════════════════════════════════════════
     의존성을 일부러 최소로 유지한다
    ══════════════════════════════════════════════════════════════════════
     이 산출물은 두 곳에 배포된다.

       [개발계] AI 플랫폼 K8s — 시뮬레이터 연동·투라코 내부망 통신 시험용. 파드로 뜬다.
       [운영]   교정본부 보라미 서버 — 단일 실행 jar 를 수동 배포한다.

     운영 쪽이 제약을 결정한다.
       · CI/CD 파이프라인을 탈 수 없다(내부망) 이므로 수동 전달 가능한 단일 실행 jar 여야 한다
       · 소스·산출물을 발주처에 제출할 가능성이 있다 이므로 불필요한 라이브러리를 넣지 않는다
       · 보안 심사 대상이다 이므로 의존성이 적을수록 통과가 쉽다
       · K8s 전용 라이브러리가 딸려 들어가면 안 된다

     그래서 web + springdoc + lombok(컴파일 전용) 만 쓴다.
     DB 접근도, ORM 도, 메시징도 필요 없다. 이 서비스가 하는 일은
     "XVARM 을 호출하고 상태를 알려주는 것" 하나뿐이다.

     K8s 배포 설정(Helm chart·Dockerfile)은 이 pom 바깥에 있고 빌드에 관여하지 않는다.
     즉 `mvn clean package` 한 줄이면 언제든 독립 실행 jar 가 그대로 나온다.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.14</version>
    <relativePath/>
  </parent>

  <properties>
    <!--
      ⚠ 보라미 WAS 의 OS·JDK 버전을 확인해야 한다(미확정).
        Spring Boot 3.x 는 Java 17 이상을 요구한다. 보라미가 Java 8/11 이라면
        Spring Boot 2.7 + Java 8 로 내려야 하며, 그 경우 이 pom 의 parent 와
        jakarta.* 에서 javax.* 로 패키지명을 함께 바꿔야 한다.
        확인 전까지는 개발계(K8s, openjdk:17-alpine)와 같은 Java 17 로 맞춰 둔다.
    -->
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>
    <buildtime>${maven.build.timestamp}</buildtime>

    <springdoc.version>2.8.17</springdoc.version>

    <group-name></group-name>
    <final-name>borami-xvarm-broker-1joiuorqhl</final-name>

    <docker-registry></docker-registry>
    <docker-name></docker-name>
    <docker-tag></docker-tag>
    <spring-profile></spring-profile>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 브로커를 단독으로 조작·검증할 수 있어야 한다. 보라미 내부망에서는
         우리가 붙어 볼 수단이 이것뿐일 수 있다. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- 컴파일 전용. 산출물 jar 에 포함되지 않는다 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    Jenkinsfile 이 `mvn clean package -P ${SPRING_PROFILES_ACTIVE}` 로 부르므로
    투라코가 쓰는 프로파일 id 를 모두 정의해 둔다. 여기서 산출물이 달라지지는 않는다
    (스프링 프로파일은 Dockerfile 의 -Dspring.profiles.active 로 주입된다).
  -->
  <profiles>
    <profile>
      <id>default</id>
      <properties>
        <profile-name>default</profile-name>
      </properties>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
    </profile>
    <profile>
      <id>local</id>
      <properties>
        <profile-name>local</profile-name>
      </properties>
    </profile>
    <profile>
      <id>dev</id>
      <properties>
        <profile-name>dev</profile-name>
      </properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties>
        <profile-name>prod</profile-name>
      </properties>
    </profile>
  </profiles>

  <build>
    <finalName>${final-name}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <mainClass>com.correction.borami.xvarm.Main</mainClass>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!--
        개발계 이미지 빌드용. executions 가 없으므로 어떤 라이프사이클에도 묶이지 않는다.
        따라서 `mvn clean package` 는 이 플러그인을 건드리지 않고, 운영용 단일 jar 빌드에
        도커가 필요하지 않다. 젠킨스가 넘기는 -Ddockerfile.skip=true 값도 여기서 받는다.
      -->
      <plugin>
        <groupId>com.spotify</groupId>
        <artifactId>dockerfile-maven-plugin</artifactId>
        <version>1.4.13</version>
        <configuration>
          <repository>${docker-registry}</repository>
          <dockerfile>./src/main/docker/Dockerfile</dockerfile>
          <buildArgs>
            <JAR_FILE>${final-name}.jar</JAR_FILE>
            <SPRING_PROFILE>${spring-profile}</SPRING_PROFILE>
          </buildArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>3.11.0.3922</version>
      </plugin>
    </plugins>
  </build>

</project>
